<!-- The letter from Material Symbols "text_format", without its underline: the
     colour buttons draw their own swatch where that bar would be.

     Dropping the bar means the path no longer starts where the original did, so
     the first move is absolute. The group undoes the source's -960..0 y axis,
     enlarges the letter about its own centre - alone it sits small in the icon's
     box - and lowers it: the original reserved the bottom third for the underline,
     so without that the letter hangs high. It ends up centred, at 5.6..18.4dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="?attr/colorControlNormal">
  <group
      android:translateY="1060"
      android:pivotX="480"
      android:pivotY="-580"
      android:scaleX="1.17"
      android:scaleY="1.17">
    <path
        android:fillColor="@android:color/black"
        android:pathData="M276,-360l164,-440h80l164,440h-76l-38,-112H392l-40,112h-76Zm138,-176h132l-64,-182h-4l-64,182Z"/>
  </group>
</vector>
