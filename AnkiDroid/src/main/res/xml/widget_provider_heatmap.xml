<?xml version="1.0" encoding="utf-8"?>
<!--
  저장할 위치: AnkiDroid/src/main/res/xml/widget_provider_heatmap.xml

  android:configure     - 위젯을 놓을 때 설정 화면을 엽니다.
  android:widgetFeatures="reconfigurable" - 안드로이드 12 이상에서
                          위젯을 길게 눌러 나중에 다시 설정할 수 있게 합니다.
  android:previewLayout - 안드로이드 12 이상의 위젯 선택 화면 미리보기.
  android:previewImage  - 안드로이드 11 이하의 미리보기.
                          AnkiDroid 기본 위젯 4개도 전부 이 둘을 갖고 있습니다.
                          둘 다 없으면 런처가 미리보기를 못 만들어
                          "위젯을 추가할 수 없습니다" 문구를 띄웁니다.
  app:widgetStyle / app:widgetSize - 삼성 One UI 블러용 (다른 런처에서는 무시됨)
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:configure="com.ichi2.widget.heatmap.HeatmapWidgetConfig"
    android:description="@string/heatmap_widget_description"
    android:initialLayout="@layout/widget_heatmap"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/heatmap_widget_preview"
    android:previewLayout="@layout/widget_heatmap_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    app:widgetSize="small|wideSmall|medium|large|extraLarge|extraLargeLong"
    app:widgetStyle="colorful" />
