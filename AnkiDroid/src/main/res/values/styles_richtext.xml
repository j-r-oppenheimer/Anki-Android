<resources>
    <!-- Sized like note_editor_toolbar_button so the icons come out the same as
         the HTML toolbar's: fitCenter draws a 24dp vector at the full 40dp the
         padding leaves behind. -->
    <style name="RichTextToolbarButton">
        <item name="android:layout_width">@dimen/rich_text_toolbar_height</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/rich_text_toolbar_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="RichTextSwatch">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">8dp</item>
        <item name="android:contentDescription">@string/rich_text_swatch</item>
    </style>

</resources>
