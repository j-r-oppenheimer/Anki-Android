<resources>
    <style name="RichTextToolbarButton">
        <item name="android:layout_width">?attr/minTouchTargetSize</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/rich_text_toolbar_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="RichTextToolbarSlot" parent="RichTextToolbarButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="RichTextToolbarDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">?attr/colorControlHighlight</item>
    </style>
</resources>
