<?xml version="1.0" encoding="utf-8"?>
<!--
  저장할 위치: AnkiDroid/src/main/res/layout/activity_heatmap_widget_config.xml

  WebView 위에 실제 앱바를 얹어서 AnkiDroid의 다른 화면과 같은 모양이 되게 합니다.
  색은 고정하지 않고 현재 테마의 값(?attr/appBarColor 등)을 그대로 씁니다.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heatmap_config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/heatmap_config_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/appBarColor"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:titleTextColor="?attr/actionBarTextColor" />

    <WebView
        android:id="@+id/heatmap_config_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
