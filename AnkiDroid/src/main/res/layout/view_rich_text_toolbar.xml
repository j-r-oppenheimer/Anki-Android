<!-- The formatting bar for the note editor's rich text mode. Each button runs a
     document.execCommand against the current selection. The two colour buttons
     draw their own swatch at runtime, so each shows the colour it will paint;
     a long press opens the palette popup. -->
<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rich_text_toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/toolbarBackgroundColor"
    android:scrollbars="none"
    android:visibility="gone">

    <!-- Height comes from the row, not the bar, so the window's bottom inset can
         be added as padding without squeezing the buttons. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/note_editor_toolbar_height"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_bold"
            style="@style/RichTextToolbarButton"
            android:src="@drawable/ic_rich_bold_24dp"
            android:contentDescription="@string/rich_text_bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_italic"
            style="@style/RichTextToolbarButton"
            android:src="@drawable/ic_rich_italic_24dp"
            android:contentDescription="@string/rich_text_italic" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_underline"
            style="@style/RichTextToolbarButton"
            android:src="@drawable/ic_rich_underlined_24dp"
            android:contentDescription="@string/rich_text_underline" />

        <View style="@style/RichTextToolbarDivider" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_highlight"
            style="@style/RichTextToolbarButton"
            android:contentDescription="@string/rich_text_highlight" />

        <View style="@style/RichTextToolbarDivider" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_text_colour"
            style="@style/RichTextToolbarButton"
            android:contentDescription="@string/rich_text_text_colour" />

        <View style="@style/RichTextToolbarDivider" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_bulleted_list"
            style="@style/RichTextToolbarButton"
            android:src="@drawable/ic_format_list_bulleted_24dp"
            android:contentDescription="@string/rich_text_bulleted_list" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/rich_numbered_list"
            style="@style/RichTextToolbarButton"
            android:src="@drawable/ic_format_list_numbered_24dp"
            android:contentDescription="@string/rich_text_numbered_list" />
    </LinearLayout>
</HorizontalScrollView>
